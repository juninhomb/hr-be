# =====================================================
# HR STORE BACKEND — Variáveis de ambiente (exemplo)
# =====================================================
# Copia este ficheiro para `.env` e ajusta os valores.

# ---------- Ambiente ----------
# Desenvolvimento local (localhost): não uses production aqui.
NODE_ENV=development

# ---------- Servidor ----------
PORT=3001

# ---------- PostgreSQL (obrigatório) ----------
# DEV local: no Postgres que já tens, cria base dedicada (sem Docker):
#   export PGADMIN_URL='postgresql://UTILIZADOR_ADMIN@127.0.0.1:5432/postgres'  # ver scripts/db-create-local-dev.sh
#   npm run db:create-local
#   npm run db:bootstrap
DATABASE_URL=postgresql://hrstore_dev:dev_local_change_me@127.0.0.1:5432/hrstore_dev

# Pool / timeouts (opcional)
# PG_POOL_MAX=20
# PG_STATEMENT_TIMEOUT_MS=15000

# ---------- Autenticação admin (obrigatório — ver src/main.js) ----------
JWT_SECRET=dev_local_jwt_secret_min_16_chars
ADMIN_USER=admin
ADMIN_PASS=altera_esta_senha_local

# Contas extra (opcional — src/controllers/authController.js)
# FERNANDA_USER=
# FERNANDA_PASS=
# TALITTA_USER=
# TALITTA_PASS=

# ---------- CORS (site público + admin browser) ----------
# Lista fixa está em src/main.js; aqui só ACRESCENTAS origens (separadas por vírgula):
# CORS_ALLOWED_ORIGINS=https://preview.example.com
# Com NODE_ENV=production local, origens HTTP em IP privado (ex.: site em http://192.168.x.x:3002)
# não entram na lista automática de dev — acrescenta explicitamente, ex.:
# CORS_ALLOWED_ORIGINS=http://192.168.1.224:3002,http://192.168.1.224:3000

# ---------- API pública /api/public — rate limit por IP ----------
# Pedidos OPTIONS (preflight) não contam. Stripe webhook (/api/public/stripe-webhook) não usa este router.
# Desactivar em diagnóstico local (evita 429 em testes de carga na mesma máquina):
# PUBLIC_API_RATELIMIT_DISABLED=1
#
# PUBLIC_API_RATELIMIT_WINDOW_MS=900000
# PUBLIC_API_RATELIMIT_MAX=320
# PUBLIC_API_RATELIMIT_STRICT_WINDOW_MS=900000
# PUBLIC_API_RATELIMIT_STRICT_MAX=48

# ---------- API pública — token opcional (camada browser) ----------
# Se definido, todas as rotas em /api/public (exceto stripe-webhook) exigem o mesmo valor no header
# X-Public-Token (ou Authorization: Bearer …). No site: NEXT_PUBLIC_PUBLIC_API_TOKEN com o mesmo segredo.
# Gera algo longo aleatório; sem esta variável o comportamento fica igual ao anterior.
# PUBLIC_API_TOKEN=

# ---------- Cupões de desconto (checkout site) ----------
# Preferência: gerir cupões em Configurações no admin (tabela discount_coupons).
# Se não existir nenhum cupão activo na BD, o backend usa este fallback:
#   CÓDIGO : p : percentagem   ou   CÓDIGO : f : euros fixos (separados por |)
# HRSTORE_DISCOUNT_COUPONS=E2E10:p:10|E2E5:f:5

# ---------- Frete ----------
# Taxa fixa para pedidos vindos do SITE PÚBLICO (Portugal continental).
# Aplicada em /api/public/orders quando is_delivery=true.
# WEBSITE_SHIPPING_FEE_EUR=5

# Taxa fallback para pedidos manuais do ADMIN em /api/orders/create
# quando is_delivery=true mas shipping_fee não vem no payload.
# DEFAULT_SHIPPING_FEE_EUR=5

# ---------- Códigos postais Portugal (checkout PT — só índice local) ----------
# Obrigatório em produção (sem API externa):
#    cd hrstore-backend && npm run build:postal-data
#    → cria `data/pt-postal-lookup.json` (Central de Dados CC-BY · derivados CTT).
# Reinicia o backend após gerar o ficheiro. O JSON está no .gitignore — corre o script
# em cada servidor de deploy ou copia o ficheiro para data/.

# Caminho alternativo ao JSON de CP (opcional).
# PT_POSTAL_LOOKUP_PATH=/caminho/para/pt-postal-lookup.json

# ---------- Stripe Checkout (hrstore-site) ----------
# Secret key (Dashboard Stripe → Developers → API keys).
# STRIPE_SECRET_KEY=sk_test_...
#
# O backend lê sempre hrstore-backend/.env e, por defeito, SOBREPÕE variáveis já injectadas
# no processo (PM2 ecosystem, systemd, Docker). Sem isto, sk_test no ambiente bloqueava sk_live no .env.
# Para o contrário (só ambiente do sistema): DOTENV_NO_OVERRIDE=1
#
# O checkout só redirecciona para URLs cujo origin está autorizado (anti open-redirect).
# Em produção (NODE_ENV=production), define pelo menos UMA das duas opções abaixo:
#
# A) Lista de origins separadas por vírgula (com ou sem path na entrada — só o origin é guardado):
# STRIPE_CHECKOUT_ALLOWED_ORIGINS=https://hrstorept.com,https://www.hrstorept.com
#
# B) Atalho: uma URL base do storefront (equivale a acrescentar esse origin à lista):
# STRIPE_PUBLIC_SITE_ORIGIN=https://hrstorept.com
#
# Origem pública do backoffice (PDV Stripe regresso a /dashboard/pdv-stripe-return).
# Em produção: adiciona também a mesma origem a STRIPE_CHECKOUT_ALLOWED_ORIGINS.
# STRIPE_ADMIN_PUBLIC_ORIGIN=https://admin.hrstorept.com
#
# Em desenvolvimento sem estas variáveis, aceita-se por defeito localhost:3002 (site) e 3000 (admin).
# Importante: se o cliente abre o site em https://www.... mas só configuraste https://sem-www,
# o Stripe falha com "origem não autorizada" — inclui ambos.
#
# STRIPE_CHECKOUT_ALLOWED_ORIGINS=https://hrstorept.com,https://www.hrstorept.com,http://localhost:3002,http://127.0.0.1:3002
#
# Webhook POST (URL pública do backend): .../api/public/stripe-webhook
# Signing secret da mesma entrada no Stripe (test vs live são diferentes):
# STRIPE_WEBHOOK_SECRET=whsec_...
# Com sk_test_: usar whsec do webhook criado em modo Test no Dashboard, ou o whsec
# que o `stripe listen --forward-to ...` imprime — não misturar com secrets de Live.
#
# STRIPE_CHECKOUT_LOCALE=pt
#
# Por defeito MB Way não entra na sessão Stripe (no site combinamo‑lo pelo WhatsApp).
# Para oferecer MB Way também na página de pagamento Stripe:
# STRIPE_ENABLE_MBWAY_IN_CHECKOUT=1
#
# Klarna no Checkout apenas se método activo na conta Stripe:
# STRIPE_ENABLE_KLARNA=1

# ---------- E-mail (Gmail / Google Workspace) ----------
# Usado quando o pagamento fica "pago" (webhook Stripe ou POST /api/orders/confirm).
#
# GMAIL_USER=conta@seudominio.pt
# MAIL_FROM=HR Store <conta@seudominio.pt>
# Opcional: resposta a outro endereço (vírgulas permitidas).
# MAIL_REPLY_TO=suporte@seudominio.pt
#
# --- Opção A (mais simples): senha de app ---
# Google Conta → Segurança → Verificação em 2 passos → Senhas de app → gera uma para «Mail» / «backend».
# São 16 letras (com ou sem espaços). NÃO é GMAIL_OAUTH_CLIENT_SECRET (isso é outra credencial).
# GMAIL_APP_PASSWORD=
#
# --- Opção B: OAuth 2 (Google Cloud Console — Client ID tipo Desktop/Web + refresh token + scopes SMTP) ---
# GMAIL_OAUTH_CLIENT_ID=....apps.googleusercontent.com
# GMAIL_OAUTH_CLIENT_SECRET=secret da consola (NÃO confundir com senha de app)
# GMAIL_OAUTH_REFRESH_TOKEN=
#
# Ligação SMTP: por defeito smtp.gmail.com:587 (STARTTLS).
# Firewall a bloquear 465 é comum; o preset antigo do Nodemailer «gmail» usava só 465.
# MAIL_SMTP_HOST=smtp.gmail.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_SECURE=0
# Para tentar só SSL na porta clássica: MAIL_SMTP_PORT=465 e MAIL_SMTP_SECURE=1
#
# Desactivar envios sem apagar credenciais (ex.: staging):
# MAIL_SENDING_ENABLED=0
#
# Destinatário das notificações internas (pedido site aguardando pagamento manual).
# Default: atendimento@hrstorept.com. Override quando quiseres outra caixa.
# ADMIN_NOTIFICATION_EMAIL=atendimento@hrstorept.com

# Timeouts SMTP Gmail (ms). Útil em rede lenta ou diagnósticos.
# MAIL_SMTP_CONNECTION_TIMEOUT_MS=20000
# MAIL_SMTP_GREETING_TIMEOUT_MS=20000
# MAIL_SMTP_SOCKET_TIMEOUT_MS=35000
# Mail de levantamento na loja (`POST /orders/:id/pickup-ready`): morada e texto extra no corpo do email.
# STORE_PICKUP_ADDRESS=Rua ..., Vila Nova de Gaia, Portugal
# STORE_PICKUP_NOTES=Horário: segunda a sexta das 10h às 18h; sábado das 10h às 14h.
#
# Pickup website: `POST /orders/:id/pickup-collected` — confirma que o cliente levantou (status → entregue).
# Migração: `database/migrations/2026-05-02_pickup_collected_at.sql`
#
# Teste CLI: MAIL_TEST_TO=... npm run mail:test
# Teste API (JWT admin): POST /api/orders/mail/test body {"to":"opcional@..."}
